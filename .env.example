# Fraud Shield AI - Environment Configuration Template
# Copy this file to '.env' and adjust the variables to override default connection settings.

# FastAPI Service Config
PORT=8000
HOST=0.0.0.0

# Redis Feature Store Endpoint
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Memgraph Graph Database Endpoint
MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687

# Redpanda Event Stream Broker Endpoint
REDPANDA_BROKER=localhost:9092
